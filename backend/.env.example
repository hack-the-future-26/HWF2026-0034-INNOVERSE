# Backend Configuration
APP_NAME=Smart Queue Management Backend
ENVIRONMENT=development
VERSION=1.0.0

# Database Settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_queue_db

# Security & JWT
JWT_SECRET_KEY=change_this_to_a_secure_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ML Service URL
ML_SERVICE_URL=http://localhost:8001
